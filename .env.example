# Backend Environment Variables
PORT=3001
NODE_ENV=development

# Database Configuration
DATABASE_URL=mongodb://localhost:27017/rupiah-quest
USE_MOCK_DB=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Cache Configuration
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# Analytics (optional)
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
SENTRY_DSN=https://your-sentry-dsn

# Frontend Environment Variables
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=development

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_SOUND=true

# Third-party Services
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
REACT_APP_FIREBASE_CONFIG=your-firebase-config

# Development Only
REACT_APP_DEBUG=true
REACT_APP_MOCK_API=false

# Production Environment Variables (uncomment for production)
# NODE_ENV=production
# DATABASE_URL=mongodb://your-production-db-url
# JWT_SECRET=your-production-jwt-secret
# FRONTEND_URL=https://your-domain.com
# REACT_APP_API_URL=https://your-api-domain.com/api
# REACT_APP_ENVIRONMENT=production
# REACT_APP_DEBUG=false